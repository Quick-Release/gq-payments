{
  "name": "getquick/gq-payments",
  "version": "0.0.1",
  "type": "wordpress-plugin",
  "license": "proprietary",
  "description": "Connects WooCommerce checkout to GETQUICK's Payment Service.",
  "homepage": "https://getquick.io",
  "authors": [
    {
      "name": "GETQUICK",
      "homepage": "https://getquick.io"
    }
  ],
  "require": {
    "php": ">=8.4.1"
  },
  "require-dev": {
    "dealerdirect/phpcodesniffer-composer-installer": "^1.2",
    "phpunit/phpunit": "^13",
    "squizlabs/php_codesniffer": "^3.13",
    "wp-coding-standards/wpcs": "^3.3"
  },
  "autoload": {
    "psr-4": {
      "GetQuick\\Payments\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "GetQuick\\Payments\\Tests\\": "tests/php/"
    }
  },
  "extra": {
    "installer-name": "gq-payments"
  },
  "config": {
    "sort-packages": true,
    "platform": {
      "php": "8.4.1"
    },
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  },
  "scripts": {
    "lint": "phpcs",
    "format": "phpcbf",
    "check": [
      "@composer validate --strict --no-check-version",
      "@lint"
    ],
    "test": "phpunit"
  },
  "archive": {
    "exclude": [
      "/*",
      "/.*",
      "!/gq-payments.php",
      "!/readme.txt",
      "!/README.md",
      "!/LICENSE",
      "!/composer.json",
      "!/src",
      "!/uninstall.php",
      "!/assets"
    ]
  }
}
